opam-version: "2.0"
synopsis: "Build and report Nix package sets in CI"
description:
  "Dependency-aware scheduling, durable build reports, and cache uploads for Nix package sets."
maintainer: ["Antonio Nuno Monteiro <anmonteiro@gmail.com>"]
authors: ["Antonio Nuno Monteiro <anmonteiro@gmail.com>"]
license: "BSD-3-clause"
homepage: "https://github.com/nix-ocaml/nix-ci-build"
bug-reports: "https://github.com/nix-ocaml/nix-ci-build/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "5.1"}
  "cmdliner"
  "yojson"
  "fmt"
  "logs"
  "eio_main"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nix-ocaml/nix-ci-build.git"
