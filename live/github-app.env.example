# Copy outside the checkout and keep the populated file private.
# Start: node --env-file=/absolute/path/to/github-app.env live/server.mjs
NIX_CI_LIVE_ACCESS_MODE=github
NIX_CI_LIVE_PUBLIC_URL=https://builds.example.com
NIX_CI_LIVE_OIDC_AUDIENCE=nix-ci-build
NIX_CI_LIVE_GITHUB_APP_ID=
NIX_CI_LIVE_GITHUB_CLIENT_ID=
NIX_CI_LIVE_GITHUB_CLIENT_SECRET=
NIX_CI_LIVE_GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app.private-key.pem
# Use distinct random values of at least 32 bytes.
NIX_CI_LIVE_GITHUB_WEBHOOK_SECRET=
# Keep stable with the database: stored OAuth tokens are encrypted with it.
NIX_CI_LIVE_SESSION_SECRET=
# Optional: restrict installations further, or change the default database path.
# NIX_CI_LIVE_REPOSITORIES=owner/repository
# NIX_CI_LIVE_DB=/absolute/path/to/events.sqlite
